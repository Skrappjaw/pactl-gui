#!/bin/sh
# postinst for the pulsar package.
set -e

# Update the desktop database if the tools are available. Harmless when
# they are not (minimal containers).
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# NOTE: deliberately no attempt to create, migrate or remove anything
# under $HOME or $XDG_DATA_HOME. User presets live in
# ~/.local/share/pulsar and are none of this package's business.

exit 0